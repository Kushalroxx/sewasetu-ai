# Required: replace with a unique deployment password before starting the portal.
ADMIN_PASSWORD=change-me-before-deploying
ADMIN_USERNAME=admin

# Local defaults. Production must use HTTPS and the externally reachable URLs.
PUBLIC_BASE_URL=http://localhost:8000
CITIZEN_RESOURCE_URL=http://localhost:8001/mcp
OFFICER_RESOURCE_URL=http://localhost:8002/mcp

# Agent tools are enabled for all portal blocks by default.
MCP_ENABLED_BLOCKS=Sonari,Rajapara,Dhemaji Pathar,Borgaon,Namti,Khelua